{
  "name": "mikuai",
  "productName": "MikuAI",
  "version": "0.1.0",
  "description": "Tu compañera de escritorio: una primera Miku que te conoce y te da la bienvenida.",
  "main": "src/main.cjs",
  "author": "bastian-alvarez",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "test:voice": "node scripts/check-voice.cjs",
    "test:desktop": "electron scripts/check-desktop.cjs",
    "check": "node --check src/main.cjs && node --check src/preload.cjs && node --check src/core.cjs && node --check src/voice.cjs && node --check src/renderer/app.js",
    "build": "electron-builder --win portable --x64",
    "build:dir": "electron-builder --win dir --x64"
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.bastian-alvarez.mikuai",
    "asar": true,
    "directories": { "output": "release" },
    "files": ["src/**/*", "assets/**/*", "package.json"],
    "extraResources": [{ "from": "scripts/windows-voice.ps1", "to": "windows-voice.ps1" }],
    "win": { "target": "portable", "icon": "assets/icon.ico", "signExecutable": false },
    "portable": { "artifactName": "MikuAI-${version}-Windows.exe" }
  }
}
